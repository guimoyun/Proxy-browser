<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 顶部工具栏（白底，参考 Via：搜索 + 标题，右上收起） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageButton
            android:id="@+id/toolbarSearch"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_search"
            android:tint="@color/icon_tint"
            android:contentDescription="@string/address_hint" />

        <TextView
            android:id="@+id/toolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:padding="8dp" />

        <EditText
            android:id="@+id/addressInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone"
            android:hint="@string/address_hint"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_search_pill"
            android:padding="8dp"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:singleLine="true" />

        <TextView
            android:id="@+id/proxyChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/bg_pill_gray"
            android:text="@string/proxy_disconnected"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/toolbarCollapse"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_close"
            android:tint="@color/icon_tint"
            android:contentDescription="@string/home" />
    </LinearLayout>

    <!-- 页面加载进度 -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:visibility="gone"
        android:progressTint="@color/accent" />

    <!-- 页内查找栏 -->
    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:background="@color/surface">

        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/find_in_page"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/btnFindPrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:tint="@color/icon_tint"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageButton
            android:id="@+id/btnFindNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_forward"
            android:tint="@color/icon_tint"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageButton
            android:id="@+id/btnFindClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_close"
            android:tint="@color/icon_tint"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- 内容区：主页 / WebView -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/homeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/surface">

            <ImageView
                android:id="@+id/homeLogo"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:src="@drawable/logo"
                android:contentDescription="@string/app_name" />

            <EditText
                android:id="@+id/homeSearchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:layout_marginTop="16dp"
                android:hint="@string/address_hint"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_search_pill"
                android:padding="12dp"
                android:drawableStart="@drawable/ic_search"
                android:drawableTint="@color/icon_tint"
                android:inputType="textUri"
                android:singleLine="true" />

            <LinearLayout
                android:id="@+id/homeProxyCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_ripple_cell"
                android:padding="12dp"
                android:gravity="center">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_node"
                    android:tint="@color/icon_tint"
                    android:contentDescription="@string/m_proxy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/m_proxy"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部五键导航（Via 风格：扁平黑白图标） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageButton
            android:id="@+id/navBack"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:src="@drawable/ic_back"
            android:tint="@color/icon_tint"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back" />

        <ImageButton
            android:id="@+id/navForward"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:src="@drawable/ic_forward"
            android:tint="@color/icon_tint"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/forward" />

        <ImageButton
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            android:tint="@color/icon_tint"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home" />

        <TextView
            android:id="@+id/navTabs"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/new_tab" />

        <ImageButton
            android:id="@+id/navMenu"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:src="@drawable/ic_menu"
            android:tint="@color/icon_tint"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu" />
    </LinearLayout>
</LinearLayout>
